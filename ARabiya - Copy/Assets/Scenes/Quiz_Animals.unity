  questions:
  - questionText: 1. What is the Arabic word for "lion"?
    options:
    - "\u0646\u0645\u0631 (namir)"
    - "\u0641\u064A\u0644 (fiil)"
    - "\u0623\u0633\u062F (asad)"
    - "\u062A\u0645\u0633\u0627\u062D (timsah)"
    correctIndex: 2
  - questionText: "2. What does \"\u063A\u0632\u0627\u0644 (ghazaal)\" mean in English?"
    options:
    - Deer
    - Camel
    - Rooster
    - Crocodile
    correctIndex: 0
  - questionText: "3. What animal is \"\u0630\u0626\u0628 (dhi\u2019b)\"?"
    options:
    - Fox
    - Wolf
    - Rabbit
    - Mouse
    correctIndex: 1
  - questionText: 4. What is the Arabic word for "fish"?
    options:
    - "\u0633\u0645\u0643\u0629 (samakah)"
    - "\u0645\u0639\u0632\u0629 (ma\u2019izah)"
    - "\u062F\u062C\u0627\u062C\u0629 (dajaajah)"
    - "\u062C\u0645\u0644 (jamal)"
    correctIndex: 0
  - questionText: "5. What does \"\u0633\u0644\u062D\u0641\u0627\u0629 (sulhufah)\"
      mean?"
    options:
    - Dolphin
    - Snake
    - Turtle
    - Elephant
    correctIndex: 2
  - questionText: "6. What animal is \"\u0643\u0644\u0628 (kalb)\" in English?"
    options:
    - Cat
    - Dog
    - Horse
    - Sheep
    correctIndex: 1
  - questionText: 7. What is the Arabic word for "pigeon"?
    options:
    - "\u063A\u0632\u0627\u0644 (ghazaal)"
    - "\u062D\u0645\u0627\u0645\u0629 (hamaamah)"
    - "\u062F\u062C\u0627\u062C\u0629 (dajaajah)"
    - "\u0641\u0623\u0631 (fa\u2019r)"
    correctIndex: 1
  - questionText: "8. \"\u0646\u0645\u0631 (namir)\" means what in English?"
    options:
    - Fox
    - Elephant
    - Tiger
    - Lion
    correctIndex: 2
  - questionText: "9. What does \"\u0646\u062D\u0644\u0629 (nahlah)\" mean?"
    options:
